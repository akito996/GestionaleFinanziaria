# ---------------------------------------------------------------
# GestionaleFinanziaria - file da NON pubblicare mai su GitHub
# ---------------------------------------------------------------

# --- Segreti e chiavi (mai nel repository) ---
# chiave di firma Android e sue password
*.jks
*.keystore
key.properties
# client OAuth Google (il client secret desktop arriva dai secret di GitHub Actions)
client_secret*.json
credentials*.json
# variabili d'ambiente locali
.env
.env.*
!.env.example
# certificati e chiavi private
*.pem
*.p12
*.pfx
*.key

# --- Dati personali: la documentazione Word resta fuori dal repo ---
*.docx
docs-src/
*.db
*.sqlite
*.sqlite3

# --- Dart / Flutter ---
# pubspec.lock VA salvato (build ripetibili e controllo vulnerabilità)
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
doc/api/
coverage/

# --- Android ---
android/.gradle/
android/local.properties
android/app/debug/
android/app/profile/
android/app/release/
android/captures/
*.iml
.cxx/

# --- Windows ---
windows/flutter/ephemeral/
*.msi
*.exe

# --- IDE e sistema ---
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db
desktop.ini
