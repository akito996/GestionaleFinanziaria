<?xml version="1.0" encoding="utf-8"?>
<!--
  Pacchetto MSIX per il Microsoft Store (ADR-017), compilato da tool/msix.ps1.
  I segnaposto {{...}} vengono dai dati dello Store (Partner Center, variabili
  del repository): sono pubblici, non segreti. Microsoft firma il pacchetto
  quando lo pubblica.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">
  <Identity
    Name="{{NOME}}"
    Publisher="{{EDITORE}}"
    Version="{{VERSIONE}}"
    ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>GestionaleFinanziaria</DisplayName>
    <PublisherDisplayName>{{NOME_EDITORE}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.17763.0"
      MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="it-IT" />
  </Resources>
  <Applications>
    <Application
      Id="GestionaleFinanziaria"
      Executable="GestionaleFinanziaria.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="GestionaleFinanziaria"
        Description="Finanza personale privacy-first e open source"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <!-- Solo per la sincronizzazione cifrata con Google Drive. -->
    <Capability Name="internetClient" />
    <!-- App desktop classica (Win32): obbligatoria per i programmi non UWP. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
